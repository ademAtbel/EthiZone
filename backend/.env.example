# Environment Configuration Template for EthiZone Backend

# MongoDB Connection String (Atlas or Cloud Instance)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/ethizone?retryWrites=true&w=majority

# Secret Key for JWT Signing (Required for production authentication)
JWT_SECRET=your_super_strong_random_jwt_secret_key_here

# Server Port
PORT=5001

# CORS & Socket Allowed Origin (Production Client URL)
CLIENT_URL=https://ethizone.com

# Initial Super Admin Boot Seed Settings
INITIAL_ADMIN_EMAIL=ethizone1@gmail.com
INITIAL_ADMIN_PASSWORD=Ethizone@Ethiopia.2019

# Distributed Redis URL (Optional - for high concurrency rate limiting and caching)
# REDIS_URL=redis://default:<password>@redis-server-url:6379

# SMTP Email Configuration (For OTP verification emails)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=ethizone1@gmail.com
EMAIL_PASS=your_gmail_app_password
